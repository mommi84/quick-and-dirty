@charset "utf-8";

:root { --_ckwJ3FCw: 400px; }

@media (min-width: 900px) and (max-width: 1199px) {
  :root { --_ckwJ3FCw: 350px; }
}

.TQmzJ, .cCWHg { animation: 0.3s ease 0s 1 normal none running juaUY; background-color: var(--scheme-surface); border-right: 1px solid var(--scheme-outline-variant); left: 0px; overflow: hidden; width: var(--_ckwJ3FCw); }

.cCWHg { z-index: var(--overlays); }

.TQmzJ { z-index: calc(var(--overlays) + 52); }

.edjLk, .jUsTK { animation: 0.3s ease 0s 1 normal none running bOxyC; background-color: var(--scheme-surface); border-left: 1px solid var(--scheme-outline-variant); left: var(--_ckwJ3FCw); transform: translateZ(0px); width: calc(100vw - var(--_ckwJ3FCw)); }

.rYpJV { overflow-y: auto; }

.edjLk { z-index: var(--overlays); }

.jUsTK { z-index: calc(var(--overlays) + 51); }

.HyMgA { animation: 0.3s ease 0s 1 normal forwards running HBnrM; }

.uXHpy { animation: 0.3s ease 0s 1 normal none running ugRte; background-color: rgba(0, 0, 0, 0.32); inset: 0px; z-index: calc(var(--overlays) + 50); }

@keyframes ugRte { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes juaUY { 
