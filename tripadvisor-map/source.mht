@charset "utf-8";

div.autocompleter-loading { float: left; clear: right; background: url("/img2/spinner.gif") center center no-repeat rgb(255, 255, 255); width: 20px; height: 16px; }

ul.autocompleter-choices { position: absolute; margin: 0px; padding: 0px; list-style: none; border: 1px solid rgb(183, 203, 146); background-color: rgb(255, 255, 255); text-align: left; font-family: Verdana, Geneva, Arial, Helvetica, sans-serif; z-index: 50; font-size: 77.5%; color: rgb(44, 44, 44); width: 250px; white-space: normal; }

ul.autocompleter-choices li { position: relative; padding: 0.1em 1.5em 0.1em 1em; cursor: pointer; font-weight: normal; font-size: 1em; }

ul.autocompleter-choices li.autocompleter-selected { background-color: rgb(246, 223, 156); color: rgb(0, 0, 0); }

ul.autocompleter-choices span.autocompleter-queried { font-weight: bold; }

ul.autocompleter-choices li.autocompleter-selected span.autocompleter-queried { color: rgb(0, 0, 0); }

ul.autocompleter-choices.flights { border: 1px solid rgb(200, 200, 200); width: 300px; }

ul.autocompleter-choices.flights li { font-size: 12px; line-height: 14px; padding: 4px 8px 3px 10px; }

.semauto-choices { position: absolute; margin: 0px; padding: 0px; list-style: none; border: 1px solid rgb(183, 203, 146); background-color: rgb(255, 255, 255); text-align: left; font-family: Arial, Helvetica, sans-serif; z-index: 50; font-size: 77.5%; color: rgb(44, 44, 44); }

.semauto-choices li { display: block; position: relative; padding: 0px; cursor: pointer; font-weight: normal; font-size: 12px; line-height: 14px; }

.semauto-choices li.autocompleter-selected { background-color: rgb(246, 223, 156); color: rgb(0, 0, 0); }

.semauto-choices span.autocompleter-queried { font-weight: bold; }

.semauto-choices li.autocompleter-selected span.autocompleter-queried { color: rgb(0, 0, 0); }

.semauto-choices .choiceMainTitle .image { color: rgb(0, 166, 128); float: right; padding: 6px 6px 6px 20px; }

.semauto-choices .choiceMainTitle .text { float: left; }

.semauto-choices .choiceMainTitle.typeDivider { border-top: 1px solid rgb(211, 224, 187); margin-top: 0px; }

